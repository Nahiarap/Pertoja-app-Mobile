<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PertoJa"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Tela de Login inicia primeiro -->
        <activity
            android:name=".activity.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tela de Cadastro -->
        <activity android:name=".activity.CadastroActivity" android:exported="false" />

        <!-- Tela de Perfil / Edição de Cadastro do Cliente -->
        <activity android:name=".activity.MeuPerfilActivity" android:exported="false" />

        <!-- Tela 1 (Home com 9 Profissionais) -->
        <activity android:name=".activity.MainActivity" android:exported="false" />

        <!-- Tela 2 (Perfil + Avaliação 1 a 5 Estrelas) -->
        <activity android:name=".activity.ProfileActivity" android:exported="false" />

        <!-- Tela 3 (Agendamento) -->
        <activity android:name=".activity.ScheduleActivity" android:exported="false" />

        <!-- Tela 4 (Confirmação e Gestão CRUD) -->
        <activity android:name=".activity.ConfirmationActivity" android:exported="false" />

        <!-- Tela 5 (Histórico Completo de Todos os Pedidos) -->
        <activity android:name=".activity.PedidosActivity" android:exported="false" />

        <!-- Tela 6 (Conversa de WhatsApp) -->
        <activity android:name=".activity.WhatsappActivity" android:exported="false" />

        <!-- Tela 7 (Ligação Telefônica) -->
        <activity android:name=".activity.CallActivity" android:exported="false" />

    </application>

</manifest>
