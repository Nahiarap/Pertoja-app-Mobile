<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Barra Superior -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:elevation="2dp">

            <ImageView
                android:id="@+id/btnVoltarConfirmation"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:contentDescription="Voltar"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#2563EB" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Detalhes do Pedido"
                android:textColor="#1F2937"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnTopoVerTodosPedidos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📋 Pedidos"
                android:textColor="#2563EB"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:gravity="center_horizontal">

            <!-- Ícone de Sucesso -->
            <androidx.cardview.widget.CardView
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#DCFCE7"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/checkbox_on_background"
                    app:tint="#16A34A" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/txtTituloStatusConfirmacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pedido #1 - Confirmado"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1F2937"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txtSubtituloConfirmacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sua solicitação foi enviada com sucesso."
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:gravity="center"
                android:layout_marginBottom="14dp" />

            <!-- Card de Resumo do Pedido -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/txtCodigoPedido"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resumo do Pedido #1"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#1F2937"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/txtResumoProfissional"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="👨‍🔧 Profissional: Castiel Bandeira"
                        android:textSize="13sp"
                        android:textColor="#374151"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/txtResumoServico"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🛠️ Serviço: Instalação Elétrica"
                        android:textSize="13sp"
                        android:textColor="#374151"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/txtResumoDataHora"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📅 Data/Hora: Hoje às 14:30"
                        android:textSize="13sp"
                        android:textColor="#374151"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/txtResumoEndereco"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📍 Endereço: Rua das Flores, 120"
                        android:textSize="13sp"
                        android:textColor="#374151"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/txtResumoProblema"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📝 Detalhes: Revisão elétrica geral"
                        android:textSize="13sp"
                        android:textColor="#374151"
                        android:layout_marginBottom="10dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E7EB"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Valor Total:"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#1F2937" />

                        <TextView
                            android:id="@+id/txtResumoValor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R$ 150,00"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#2563EB" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Botões de WhatsApp e Ligar Direto da Confirmação -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnWaConfirmacao"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="💬 WhatsApp"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#25D366"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btnLigarConfirmacao"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="📞 Ligar"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#111827"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- Card Amarelo Interativo: Marcar de 1 a 5 Estrelas -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFBEB"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ Avaliar Atendimento (1 a 5 Estrelas)"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#92400E"
                        android:layout_marginBottom="4dp" />

                    <RatingBar
                        android:id="@+id/ratingBarConfirmacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:stepSize="1.0"
                        android:rating="5.0"
                        android:progressTint="#F59E0B" />

                    <TextView
                        android:id="@+id/txtNotaConfirmacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sua nota: 5 de 5 Estrelas (★★★★★)"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#B45309"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/editComentarioConfirmacao"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_spinner"
                        android:hint="Comentário da avaliação (ex: Ótimo serviço!)"
                        android:paddingHorizontal="12dp"
                        android:textSize="13sp"
                        android:textColor="#111827"
                        android:textColorHint="#4B5563"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/btnEditarPedidoApi"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:text="⭐ Salvar Nota"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#16A34A"
                        app:cornerRadius="10dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Botões Inferiores: Cancelar e Todos os Pedidos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/btnCancelarPedidoApi"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="🗑️ Cancelar"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#EF4444"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btnVerTodosPedidos"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="📋 Todos os Pedidos"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1E40AF"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnVoltarInicio"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Voltar para o Início"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#2563EB"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
