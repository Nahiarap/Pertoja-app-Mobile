<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Barra Superior -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:elevation="2dp">

            <ImageView
                android:id="@+id/btnVoltar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="12dp"
                android:contentDescription="Voltar"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#2563EB" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Perfil do Profissional"
                android:textColor="#1F2937"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="48dp"
                android:layout_height="48dp" />
        </LinearLayout>

        <!-- Conteúdo do Perfil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:gravity="center_horizontal">

            <!-- Foto do Perfil -->
            <androidx.cardview.widget.CardView
                android:layout_width="110dp"
                android:layout_height="110dp"
                app:cardCornerRadius="55dp"
                app:cardElevation="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/imgPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/castiel" />
            </androidx.cardview.widget.CardView>

            <!-- Nome do Prestador -->
            <TextView
                android:id="@+id/txtNomePerfil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Castiel Bandeira"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="#1F2937"
                android:layout_marginBottom="4dp" />

            <!-- Profissão, Média de Estrelas e Quantidade de Avaliações -->
            <TextView
                android:id="@+id/txtProfissaoProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Eletricista Residencial • ⭐ 4.8 (35 avaliações) • R$ 150,00"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1F2937"
                android:layout_marginBottom="6dp" />

            <!-- Distância e Telefone -->
            <TextView
                android:id="@+id/txtDistanciaProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 a 700m de você • Asa Sul • 📞 (61) 99911-0001"
                android:textSize="12sp"
                android:textColor="#2563EB"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Botão Agendar (Azul) -->
            <Button
                android:id="@+id/btnAgendar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="📅 Agendar Serviço"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#2563EB"
                app:cornerRadius="12dp"
                android:layout_marginBottom="10dp" />

            <!-- Linha com WhatsApp e Ligar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnWhatsapp"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="💬 WhatsApp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="#25D366"
                    app:cornerRadius="12dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnLigar"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="📞 Ligar Agora"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:backgroundTint="#111827"
                    app:cornerRadius="12dp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Card de Sobre o Profissional -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sobre o Profissional"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:textColor="#1F2937"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/txtSobreProfile"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Profissional certificado e especializado em instalações elétricas residenciais."
                        android:textSize="13sp"
                        android:textColor="#4B5563"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card Amarelo para Avaliar de 1 a 5 Estrelas Direto no Perfil -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFBEB"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⭐ Avalie este Profissional (1 a 5 Estrelas)"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#92400E"
                        android:layout_marginBottom="6dp" />

                    <RatingBar
                        android:id="@+id/ratingBarPerfil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:numStars="5"
                        android:stepSize="1.0"
                        android:rating="5.0"
                        android:progressTint="#F59E0B" />

                    <TextView
                        android:id="@+id/txtNotaEscolhidaPerfil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nota selecionada: 5 de 5 estrelas"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#B45309"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/editComentarioPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_spinner"
                        android:hint="Escreva um comentário sobre o atendimento..."
                        android:paddingHorizontal="12dp"
                        android:textSize="13sp"
                        android:textColor="#111827"
                        android:textColorHint="#4B5563"
                        android:layout_marginBottom="8dp" />

                    <Button
                        android:id="@+id/btnEnviarAvaliacaoPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="⭐ Enviar Avaliação"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#D97706"
                        app:cornerRadius="10dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Card de Lista de Avaliações Recebidas -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/txtHeaderAvaliacoesPerfil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💬 Avaliações de Clientes (35 avaliações)"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#1F2937"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:id="@+id/containerAvaliacoesPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
