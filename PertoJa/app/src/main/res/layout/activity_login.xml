<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F8F9FA"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <!-- Logo / Nome do App -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PertoJá ⚡"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#2563EB"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Entre na sua conta para acessar o aplicativo"
        android:textSize="14sp"
        android:textColor="#4B5563"
        android:layout_marginBottom="28dp" />

    <!-- Campo de E-mail -->
    <EditText
        android:id="@+id/editEmail"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_spinner"
        android:hint="Seu e-mail cadastrado"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="16dp"
        android:textColor="#111827"
        android:textColorHint="#4B5563"
        android:textSize="14sp"
        android:layout_marginBottom="14dp" />

    <!-- Campo de Senha com Olho Cortado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_spinner"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="6dp"
        android:layout_marginBottom="22dp">

        <EditText
            android:id="@+id/editSenha"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Sua senha"
            android:inputType="textPassword"
            android:textColor="#111827"
            android:textColorHint="#4B5563"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btnOlhoSenhaLogin"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Mostrar ou ocultar senha"
            android:src="@drawable/ic_eye_off" />
    </LinearLayout>

    <!-- Botão de Entrar -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Entrar"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2563EB"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- Link para Cadastro -->
    <TextView
        android:id="@+id/tvIrCadastro"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Não tem uma conta? Cadastre-se"
        android:textColor="#2563EB"
        android:textSize="14sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true" />

    <!-- Configuração discreta do servidor para conectar de outros celulares -->
    <TextView
        android:id="@+id/tvConfigServidor"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="⚙️ Configurar IP do Servidor"
        android:textColor="#6B7280"
        android:textSize="12sp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
