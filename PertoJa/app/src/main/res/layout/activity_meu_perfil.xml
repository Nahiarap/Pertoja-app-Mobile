<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- Barra Superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnVoltarMeuPerfil"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:contentDescription="Voltar"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#2563EB" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Meu Perfil e Cadastro"
            android:textColor="#111827"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <!-- Foto de Perfil do Cliente -->
            <androidx.cardview.widget.CardView
                android:layout_width="112dp"
                android:layout_height="112dp"
                app:cardCornerRadius="56dp"
                app:cardElevation="4dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/imgMinhaFoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/av_helena" />
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btnAlterarFoto"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="📷 Alterar Foto"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#1D4ED8"
                android:backgroundTint="#DBEAFE"
                app:cornerRadius="20dp"
                android:layout_marginBottom="16dp" />

            <!-- Formulário de Edição de Cadastro -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nome completo:"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/editMeuNome"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_spinner"
                    android:hint="Seu nome completo"
                    android:inputType="textPersonName|textCapWords"
                    android:paddingHorizontal="14dp"
                    android:textColor="#111827"
                    android:textColorHint="#4B5563"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="E-mail:"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/editMeuEmail"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_spinner"
                    android:hint="Seu e-mail"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="14dp"
                    android:textColor="#111827"
                    android:textColorHint="#4B5563"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Telefone / WhatsApp:"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/editMeuTelefone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_spinner"
                    android:hint="Ex: (61) 99999-8888"
                    android:inputType="phone"
                    android:paddingHorizontal="14dp"
                    android:textColor="#111827"
                    android:textColorHint="#4B5563"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tipo de Conta:"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937"
                    android:layout_marginBottom="4dp" />

                <RadioGroup
                    android:id="@+id/rgMeuTipoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <RadioButton
                        android:id="@+id/rbMeuCliente"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Cliente"
                        android:textColor="#111827"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbMeuPrestador"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="24dp"
                        android:text="Prestador"
                        android:textColor="#111827"
                        android:textSize="14sp" />
                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nova Senha (deixe vazio para manter a atual):"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_spinner"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="6dp"
                    android:layout_marginBottom="20dp">

                    <EditText
                        android:id="@+id/editMinhaNovaSenha"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:hint="Digite uma nova senha se quiser alterar"
                        android:inputType="textPassword"
                        android:textColor="#111827"
                        android:textColorHint="#4B5563"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/btnOlhoNovaSenha"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Mostrar ou ocultar senha"
                        android:src="@drawable/ic_eye_off" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSalvarMeuPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="💾 Salvar Alterações"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:backgroundTint="#16A34A"
                    app:cornerRadius="12dp"
                    android:layout_marginBottom="10dp" />

                <Button
                    android:id="@+id/btnSairConta"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="🚪 Sair da Conta"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="#EF4444"
                    app:cornerRadius="12dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
