<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="#E5DDD5">

    <!-- Cabeçalho Verde do WhatsApp -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#075E54"
        android:gravity="center_vertical"
        android:paddingHorizontal="6dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/btnVoltarWa"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            android:layout_marginStart="6dp">

            <ImageView
                android:id="@+id/imgFotoWa"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/castiel" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/txtNomeWa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Castiel Bandeira"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtStatusWa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● online agora no WhatsApp"
                android:textColor="#A7F3D0"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnLigarDoWa"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="📞"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Área de Mensagens do Chat -->
    <ScrollView
        android:id="@+id/scrollChatWa"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/containerMensagensWa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp" />
    </ScrollView>

    <!-- Barra de Mensagens Rápidas -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F0ECE1"
        android:paddingVertical="6dp"
        android:paddingHorizontal="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnQuickHoje"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Disponibilidade hoje?"
                android:textSize="11sp"
                android:textColor="#075E54"
                android:backgroundTint="#FFFFFF"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnQuickSos"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="🚨 SOS Urgente"
                android:textSize="11sp"
                android:textColor="#DC2626"
                android:backgroundTint="#FFFFFF"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnQuickOrcamento"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Confirmar orçamento"
                android:textSize="11sp"
                android:textColor="#075E54"
                android:backgroundTint="#FFFFFF" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Rodapé de Digitação -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F0F0F0"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/editMensagemWa"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_spinner"
            android:hint="Digite uma mensagem..."
            android:paddingHorizontal="16dp"
            android:textColor="#111827"
            android:textColorHint="#6B7280"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnEnviarWa"
            android:layout_width="54dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="#075E54"
            android:text="➤"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            app:cornerRadius="23dp" />
    </LinearLayout>

</LinearLayout>
